# MongoDB (Atlas или локальный инстанс)
MONGODB_URI=mongodb://localhost:27017/intelligent-trails

# NextAuth v5 — сгенерируй: openssl rand -base64 32
AUTH_SECRET=

# OAuth Яндекс (https://oauth.yandex.ru)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Ключ JS API Яндекс.Карт (отрисовка карты в браузере)
NEXT_PUBLIC_YANDEX_API_KEY=

# Ключ Suggest API Яндекс (подсказки адресов) — опционально
NEXT_PUBLIC_YANDEX_SUGGEST_API_KEY=
# Серверный fallback Suggest (используется, если NEXT_PUBLIC_ не задан)
YANDEX_SUGGEST_API_KEY=

# ─── Geo-слой, облачный тир (docs/ADR/adr-001-geo-provider.md) ───

# OpenRouteService — роутинг и матрица пешеходных расстояний (тир 1, CloudProvider).
# Бесплатный ключ: https://openrouteservice.org/dev/#/signup. Без ключа
# маршрут/матрица честно деградируют до GeoError('NO_ROUTE').
OPENROUTESERVICE_API_KEY=

# Photon (https://photon.komoot.io), Nominatim (https://nominatim.openstreetmap.org)
# и Overpass публичные — ключей не требуют и в env не выносятся.
# Живые интеграционные тесты: RUN_GEO_LIVE_TESTS=1 включает их в
# src/lib/geo/__tests__/cloud.integration.test.ts (ORS-тесты — по наличию ключа выше).
